{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true,
    "rootDir": "tools/harness",
    "outDir": ".verification/bin"
  },
  "include": ["tools/harness/**/*.ts"],
  "exclude": ["tools/harness/**/*.test.ts"]
}
