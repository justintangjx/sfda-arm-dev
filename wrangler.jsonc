{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sfda-arm-dev",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/auth/setup", "/auth/recovery"],
  },
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    "APP_ENV": "local",
    "APP_ORIGIN": "http://127.0.0.1:5173",
    "RELEASE_ID": "local",
    "VOICE_ENABLED": "false",
  },
  "env": {
    "preview": {
      "name": "sfda-arm-dev-preview",
      "vars": {
        "APP_ENV": "preview",
        "APP_ORIGIN": "http://127.0.0.1:5173",
        "RELEASE_ID": "local",
        "VOICE_ENABLED": "false",
      },
    },
    "production": {
      "name": "sfda-arm-dev-production",
      "vars": {
        "APP_ENV": "production",
        "APP_ORIGIN": "https://sfda-arm-dev-production.justintang.workers.dev ",
        "RELEASE_ID": "0000000000000000000000000000000000000000",
        "VOICE_ENABLED": "false",
        "ACCOUNT_OPERATIONS_ENABLED": "false",
      },
    },
  },
}
