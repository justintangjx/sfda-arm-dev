{
  "name": "sfda-arm-dev",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.ts",
    "dev": "vite",
    "dev:preview": "CLOUDFLARE_ENV=preview vite",
    "dev:local": "node scripts/live-local.ts dev",
    "dev:voice": "node scripts/voice-local.ts",
    "build": "pnpm typecheck && vite build",
    "build:preview": "pnpm typecheck && CLOUDFLARE_ENV=preview vite build",
    "typegen": "wrangler types",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:commit": "pnpm lint && pnpm format:check && pnpm typecheck",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:live": "node scripts/live-local.ts test",
    "check": "pnpm lint && pnpm format:check && pnpm build && pnpm test && pnpm e2e",
    "db:start": "node scripts/supabase-local.ts start",
    "db:apply": "node scripts/supabase-local.ts apply",
    "db:types": "node scripts/supabase-local.ts types",
    "test:db": "node scripts/supabase-local.ts test",
    "test:auth": "node scripts/supabase-local.ts auth",
    "db:bootstrap": "node scripts/bootstrap-local.ts",
    "operator:admin": "node scripts/operator-admin.ts",
    "db:restart": "node scripts/supabase-local.ts restart",
    "db:reset": "node scripts/supabase-local.ts reset",
    "verify": "node scripts/verify.ts"
  },
  "dependencies": {
    "@elevenlabs/react": "1.17.0",
    "@supabase/supabase-js": "^2.117.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "pg": "^8.23.1",
    "prettier": "3.9.9",
    "supabase": "^2.120.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.3",
    "wrangler": "4.148.0"
  }
}
