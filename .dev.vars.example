# You can copy this file to .dev.vars for local development.
# You can get these public settings from your local Supabase CLI output.
# Blank values deliberately produce CONFIG_INVALID in the local profile.
SUPABASE_URL=
SUPABASE_PUBLIC_KEY=
SUPABASE_ADMIN_KEY=
# Voice stays disabled during ordinary local use.
VOICE_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_VERSION_ID=
VOICE_CONFIG_FINGERPRINT=
# Production demo voice only: UUID from verification/demo-voice-activation.json
VOICE_ACTIVATION_EVIDENCE_ID=
# Production account routes only (Wrangler var, not a secret)
ACCOUNT_OPERATIONS_ENABLED=false
# The trusted launcher supplies VOICE_LOCAL_RUN_RECORD for an approved synthetic run.
